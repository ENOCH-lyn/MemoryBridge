# Copy to .env for docker compose. Keep this file free of real secrets.
# Optional legacy static service token for MCP; leave empty to use per-user API tokens.
MEMBRIDGE_TOKEN=

# Optional strong initial admin password; if omitted the first admin is admin/admin
# and is forced to change it at first login.
MEMBRIDGE_ADMIN_PASSWORD=

# First UI login: admin / admin (or MEMBRIDGE_ADMIN_PASSWORD). You will be forced to change it.
