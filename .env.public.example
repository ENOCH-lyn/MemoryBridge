# Public deployment: Caddy gets a certificate for this hostname.
# Point an A/AAAA record at the server first, then:
#   cp .env.public.example .env
#   docker compose -f compose.public.yaml up -d --build
DOMAIN=memory.example.com

# Optional: set a strong initial admin password before the first boot.
# If omitted, the first admin is admin/admin and MUST be changed at first login.
# MEMBRIDGE_ADMIN_PASSWORD=replace-with-a-long-random-password

# Optional bootstrap memory cap per scope (default 20, max 100).
# MEMBRIDGE_BOOTSTRAP_MEMORY_LIMIT=20

# Set by compose.public.yaml for the hub:
MEMBRIDGE_COOKIE_SECURE=1
